{
  "name": "premkumar-portfolio-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-10-10",
  "vars": {
    "ALLOWED_ORIGINS": "https://premkumar2910a.github.io,http://127.0.0.1:4174",
    "OPENROUTER_MODEL": "openrouter/free"
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "ratelimits": [{
    "name": "CHAT_LIMITER",
    "namespace_id": "1001",
    "simple": {"limit": 10, "period": 60}
  }]
}
